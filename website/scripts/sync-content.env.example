# 复制为 sync-content.env（已被 gitignore），按需修改后即可免参数运行 ./sync-content.sh
# 服务器 SSH 地址（必填）
DEPLOY_HOST="deploy@weelume.com"
# 服务器上 docker bind-mount 的内容根目录（与 docker run -v 左侧一致）
DEPLOY_DEST="/home/deploy/workspace/website/md"
# SSH 端口（默认 22）
DEPLOY_PORT="22"
# SSH 私钥文件（可选）
# DEPLOY_KEY="$HOME/.ssh/id_ed25519"
