# Dependencies & build outputs
node_modules
.next
dist
dist-ssr
out

# 本地缓存 / 归档 / 截图，绝不应进入构建上下文（曾导致 ~2GB 上下文传输）
.pnpm-store
.local-screenshots
*.tar

# Version control
.git
.gitignore
.gitattributes

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode
.idea
.DS_Store
Thumbs.db
*.swp
*.swo

# Env files (must be injected at runtime, not baked into image)
.env
.env.*
!.env.example

# Test / coverage
coverage
.nyc_output

# Docker / CI artifacts
Dockerfile
.dockerignore
README.md
*.local

# pnpm-workspace.yaml 仅用于本地 pnpm 10/11 的构建脚本审批（onlyBuiltDependencies）；
# 镜像使用 pnpm 9.15.4，会把它当作 monorepo 清单并因缺少 packages 字段而报错
# "packages field missing or empty"，故排除，避免污染构建上下文
pnpm-workspace.yaml
