# community-backend 环境变量样例
# 复制为仓库根的 .env（或导出为环境变量）后填入真实值；请勿提交真实凭据。

# 运行环境：development / test / production
COMMUNITY_BACKEND_ENV=development

# 是否开启 FastAPI debug
COMMUNITY_BACKEND_DEBUG=true

# 日志级别：DEBUG / INFO / WARNING / ERROR / CRITICAL（开发环境建议 DEBUG）
COMMUNITY_BACKEND_LOG_LEVEL=DEBUG

# API 路由前缀
COMMUNITY_BACKEND_API_PREFIX=/api/v1

# 开发库连接串：复用现有 PostgreSQL 实例，使用新建数据库 community
# 格式：postgresql+asyncpg://<user>:<password>@<host>:5432/community
COMMUNITY_BACKEND_DEVELOPMENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/community

# 生产库连接串（部署时填写）
# COMMUNITY_BACKEND_PRODUCTION_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/community
