      font-family: 'Alibaba PuHuiTi', 'AlibabaPuHuiTi-3-85-Bold', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
      font-optical-sizing: auto;
      font-feature-settings: "palt";
    }
    /* 报告里的"中文衬线大字"位（h1/h2 + 一句话答卷 + stats 数字）
       原本走 Noto Serif SC，现在统一切到普惠体 Bold——保留 class 名兼容
       现存模板和已有报告，不改 markup。 */
    .font-serif-zh {
      font-family: 'Alibaba PuHuiTi', 'AlibabaPuHuiTi-3-85-Bold', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    ::selection { background-color: rgba(167, 139, 250, 0.35); color: #fff; }
    ::-webkit-scrollbar { width: 10px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.08);
      border-radius: 9999px;
      border: 2px solid transparent;
      background-clip: padding-box;
    }
    ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.18); background-clip: padding-box; }

    /* Hero 一句话答卷渐变文字 */
    .text-shimmer {
      background: linear-gradient(120deg, #F5F5F7 0%, #A78BFA 40%, #22D3EE 70%, #F5F5F7 100%);
      background-size: 200% 200%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: shimmerText 12s linear infinite;
    }
    @keyframes shimmerText {
      0% { background-position: 0% 50%; }
      100% { background-position: 200% 50%; }
    }

    .glass {
      background: rgba(13,13,18,0.55);
      backdrop-filter: saturate(160%) blur(18px);
      -webkit-backdrop-filter: saturate(160%) blur(18px);
      border: 1px solid rgba(255,255,255,0.08);
    }
    .accent-bar { border-left: 3px solid #10b981; }
    .accent-bar-deep { border-left: 3px solid #064e3b; }
    .zh-justify { text-align: justify; text-justify: inter-ideograph; }

    /* "必须答的问题" 答疑卡片 */
    .qa-card {
      border-left: 3px solid #10b981;
      background: rgba(16,185,129,0.05);
      padding: 1rem 1.25rem;
      margin: 1.5rem 0;
      backdrop-filter: blur(8px);
    }
    .qa-card-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.35em;
      color: #10b981;
      margin-bottom: 0.6rem;
    }

    /* 表格 */
    table.report-table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.25rem 0;
      font-size: 14px;
    }
    table.report-table thead th {
      border-bottom: 1px solid rgba(255,255,255,0.12);
      background: rgba(255,255,255,0.04);
      padding: 0.75rem 0.85rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.18em;
      color: #b8aa96;
      text-align: left;
    }
    table.report-table tbody td {
      border-bottom: 1px solid rgba(255,255,255,0.08);
      padding: 0.75rem 0.85rem;
      vertical-align: top;
      color: #D4D4D8;
      line-height: 1.85;
    }
    table.report-table tbody tr:last-child td { border-bottom: none; }

    /* 章节分割 */
    .chapter-divider {
      text-align: center;
      letter-spacing: 1em;
      color: rgba(255,255,255,0.15);
      font-size: 16px;
      margin: 3.5rem 0;
    }

    /* 引用块 */
    blockquote.report-quote {
      border-left: 3px solid #10b981;
      background: rgba(255,255,255,0.04);
      padding: 1rem 1.5rem;
      margin: 1.5rem 0;
      backdrop-filter: blur(8px);
      color: #e7dfd4;
      font-size: 15.5px;
      line-height: 1.95;
    }
    blockquote.report-quote cite {
      display: block;
      margin-top: 0.75rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.18em;
      color: #10b981;
      font-style: normal;
    }

    /* 内联 cite（作品标题引用） */
    cite { font-style: normal; color: #34d399; font-weight: 500; }

    /* 框架角标 */
    .framework-tag {
      display: inline-block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #8A8A94;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      padding: 2px 8px;
      border-radius: 4px;
      margin-left: 0.5rem;
      vertical-align: middle;
    }

    /* 正文段落 */
    .prose-body { font-size: 15px; line-height: 2.05; color: #d6cfc4; }
    .prose-body p { margin-bottom: 18px; }
    .prose-body code {
      font-family: 'JetBrains Mono', monospace;
      font-size: 13px;
      background: rgba(255,255,255,0.06);
      padding: 1px 6px;
      border-radius: 3px;
      color: #10b981;
    }

    /* 小节标题 */
    .subhead {
      border-left: 3px solid #10b981;
      padding-left: 0.85rem;
      margin: 2.5rem 0 1rem;
      font-family: 'Alibaba PuHuiTi', 'AlibabaPuHuiTi-3-65-Medium', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
      font-size: 18px;
      font-weight: 600;
      line-height: 1.4;
      letter-spacing: 0.04em;
      color: #fffdf7;
    }

    strong { color: #fffdf7; font-weight: 600; }

    /* 切片配图 grid（参见 SKILL.md §写作规则·切片配图建议）
       每条作品配图必须有 figcaption 解释该画面证明什么判断；
       alt / figcaption 都不允许出现内部词（样本 / 关键帧 / pos N 等） */
    .frame-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin: 1.5rem 0;
    }
    .frame-grid img {
      width: 100%;
      aspect-ratio: 9 / 16;
      object-fit: cover;
      border-radius: 8px;
      border: 1px solid rgba(255, 255, 255, 0.08);
      display: block;
    }
    .frame-grid figcaption {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      color: #8A8A94;
      margin-top: 6px;
      letter-spacing: 0.05em;
      line-height: 1.6;
    }

    /* 关键判断 / 压力测试卡片 */
    .judge-card {
      border-radius: 0.5rem;
      border: 1px solid rgba(255, 255, 255, 0.08);
      background: rgba(255, 255, 255, 0.03);
      padding: 1rem 1.25rem;
      margin: 1rem 0;
    }
    .judge-card .label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 10.5px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.3em;
      color: #34d399;
      margin-bottom: 0.4rem;
    }

    /* 来源脚注：嵌在正文或大字数字中的「（来源：XX，年份）」标记。
       强制小字 + 浅色 + 等宽，避免继承父级字号（如 text-4xl 的大数字）。
       white-space:nowrap 让每条脚注作为不可拆分的原子单位换行。 */
    .citation {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.04em;
      color: #8A8A94;
      vertical-align: baseline;
      margin-left: 0.4em;
      display: inline-block;
      white-space: nowrap;
      line-height: 1.4;
    }
    .citation a,
    .citation-link {
      color: #8A8A94;
      text-decoration: none;
      border-bottom: 1px dotted rgba(255,255,255,0.22);
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .citation a:hover,
    .citation-link:hover {
      color: #34d399;
      border-bottom-color: #34d399;
    }

    /* 大数字 callout 专用结构：数字单独占一行 + 来源脚注独立小字行 + 解释段落。
       推荐与 .stat-callout 配合使用，避免把 .citation 直接塞进 .text-4xl 父元素里 */
    .stat-callout {
      display: flex;
      flex-direction: column;
      gap: 6px;
      align-items: flex-start;
    }
    .stat-callout .stat-value {
      font-size: clamp(2rem, 4vw, 2.75rem);
      font-weight: 700;
      color: #10b981;
      line-height: 1.05;
      letter-spacing: -0.01em;
    }
    .stat-callout .stat-source {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.04em;
      color: #8A8A94;
      line-height: 1.4;
    }
    .stat-callout .stat-source a {
      color: #8A8A94;
      text-decoration: none;
      border-bottom: 1px dotted rgba(255,255,255,0.22);
    }
    .stat-callout .stat-source a:hover {
      color: #34d399;
      border-bottom-color: #34d399;
    }
  </style>
</head>

