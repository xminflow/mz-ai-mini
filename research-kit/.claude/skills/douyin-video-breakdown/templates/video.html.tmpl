      </p>

      <!-- Stats 矩阵（播放/点赞/评论/分享） -->
      <dl class="grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-6 border-y border-white/10 py-7 mb-12">
        <div>
          <dt class="font-mono text-[10.5px] tracking-[0.3em] uppercase text-muted mb-1.5">Plays · 播放</dt>
          <dd class="font-serif-zh text-[26px] sm:text-[28px] font-semibold text-ink leading-none">{{play_count_value}}<span class="text-[14px] ml-1 text-ink-soft tracking-normal align-baseline">{{play_count_unit}}</span></dd>
        </div>
        <div>
          <dt class="font-mono text-[10.5px] tracking-[0.3em] uppercase text-muted mb-1.5">Likes · 点赞</dt>
          <dd class="font-serif-zh text-[26px] sm:text-[28px] font-semibold text-ink leading-none">{{digg_count_value}}<span class="text-[14px] ml-1 text-ink-soft tracking-normal align-baseline">{{digg_count_unit}}</span></dd>
        </div>
        <div>
          <dt class="font-mono text-[10.5px] tracking-[0.3em] uppercase text-muted mb-1.5">Comments · 评论</dt>
          <dd class="font-serif-zh text-[26px] sm:text-[28px] font-semibold text-ink leading-none">{{comment_count_value}}<span class="text-[14px] ml-1 text-ink-soft tracking-normal align-baseline">{{comment_count_unit}}</span></dd>
        </div>
        <div>
          <dt class="font-mono text-[10.5px] tracking-[0.3em] uppercase text-muted mb-1.5">Shares · 分享</dt>
          <dd class="font-serif-zh text-[26px] sm:text-[28px] font-semibold text-ink leading-none">{{share_count_value}}<span class="text-[14px] ml-1 text-ink-soft tracking-normal align-baseline">{{share_count_unit}}</span></dd>
