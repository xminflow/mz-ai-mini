        <p class="font-serif-zh text-[20px] sm:text-[24px] font-semibold leading-[1.7] tracking-[0.05em] text-ink max-w-2xl mx-auto">
          <!-- TODO(summary): 用一句话说清这条视频的核心武器。
            结构建议：「这条视频靠 <span class="text-shimmer">XXX</span>，打中了一群
            <目标受众>的<心理任务>。」
            核心武器词用 <span class="text-shimmer"> 包裹（1-3 个关键词）获得渐变效果。
          -->
        </p>
        <span class="mx-auto mt-7 block h-px w-12 bg-report"></span>
      </div>
    </section>

    <!-- 行内目录（小屏使用；xl+ 由左侧固定边栏接管） -->
    <nav class="mb-16 border-t border-b border-white/10 py-8 xl:hidden">
