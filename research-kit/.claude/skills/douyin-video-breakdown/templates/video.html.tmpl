        <p><span class="text-muted">发布</span> <span class="font-mono">{{publish_date}}</span></p>
        <p><span class="text-muted">作者</span> {{author_name}}</p>
      </div>
    </div>
  </aside>

  <main class="mx-auto max-w-3xl px-6 pt-14 pb-24 xl:mx-0 xl:max-w-3xl xl:px-10">

    <!-- ====== HERO · 视频名片 + 一句话判断 ====== -->
    <section id="summary" class="mb-16 pt-2">

      <!-- 视频标签 -->
      <p class="font-mono text-[10.5px] tracking-[0.4em] uppercase text-report mb-4">
        Video Breakdown · 单视频拆解
      </p>

      <!-- 视频标题 -->
      <h1 class="font-serif-zh text-[32px] sm:text-[40px] font-semibold leading-[1.2] tracking-[0.03em] text-ink mb-4">
        {{title_clean}}
      </h1>

      <!-- 作者 + 元数据 -->
      <p class="font-mono text-[12px] tracking-[0.18em] text-ink-soft mb-8 flex flex-wrap items-center gap-x-3 gap-y-1.5">
        <span class="text-ink">{{author_name}}</span>
        <span class="text-white/15">·</span>
        <span>@<span class="text-report">{{author_douyin_id}}</span></span>
        <span class="text-white/15">·</span>
        <span>{{duration_mm_ss}}</span>
        <span class="text-white/15">·</span>
