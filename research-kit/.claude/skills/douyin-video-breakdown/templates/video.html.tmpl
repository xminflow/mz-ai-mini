      color: #D4D4D8;
      line-height: 1.85;
    }
    table.report-table tbody tr:last-child td { border-bottom: none; }

    .chapter-divider {
      text-align: center;
      letter-spacing: 1em;
      color: rgba(255,255,255,0.15);
      font-size: 16px;
      margin: 3.5rem 0;
    }

    blockquote.report-quote {
      border-left: 3px solid #10b981;
      background: rgba(255,255,255,0.04);
      padding: 1rem 1.5rem;
      margin: 1.5rem 0;
      backdrop-filter: blur(8px);
      color: #e7dfd4;
      font-size: 15.5px;
      line-height: 1.95;
    }
    blockquote.report-quote cite {
      display: block;
      margin-top: 0.75rem;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11.5px;
      font-weight: 600;
      letter-spacing: 0.18em;
      color: #10b981;
      font-style: normal;
    }

    cite { font-style: normal; color: #34d399; font-weight: 500; }

    .framework-tag {
      display: inline-block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #8A8A94;
