<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1080, height=1920, initial-scale=1.0">
  <title>slide-bullets</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'bg-base': '#050507',
            'accent':  '#10b981',
            'purple':  '#A78BFA',
            'cyan':    '#22d3ee',
          },
          fontFamily: {
            sans: ['AlibabaPuHuiTi', 'PingFang SC', 'Microsoft YaHei', 'sans-serif'],
            mono: ['JetBrains Mono', 'Courier New', 'monospace'],
          },
        },
      },
    };
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    @font-face {
      font-family: 'AlibabaPuHuiTi';
      font-weight: 400;
      src: url('https://cdn.jsdelivr.net/npm/@alifd/fonts@1.0.1/AlibabaPuHuiTi-3/AlibabaPuHuiTi-3-55-Regular/AlibabaPuHuiTi-3-55-Regular.woff2') format('woff2');
      font-display: swap;
    }
    @font-face {
      font-family: 'AlibabaPuHuiTi';
      font-weight: 700;
      src: url('https://cdn.jsdelivr.net/npm/@alifd/fonts@1.0.1/AlibabaPuHuiTi-3/AlibabaPuHuiTi-3-75-SemiBold/AlibabaPuHuiTi-3-75-SemiBold.woff2') format('woff2');
      font-display: swap;
    }
    @font-face {
      font-family: 'AlibabaPuHuiTi';
      font-weight: 800;
      src: url('https://cdn.jsdelivr.net/npm/@alifd/fonts@1.0.1/AlibabaPuHuiTi-3/AlibabaPuHuiTi-3-85-Bold/AlibabaPuHuiTi-3-85-Bold.woff2') format('woff2');
      font-display: swap;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 1080px; height: 1920px;
      overflow: hidden;
      background: #050507;
      color: #fff;
      font-family: 'AlibabaPuHuiTi', 'PingFang SC', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ── 关键帧 ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(28px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    @keyframes slideRight {
      from { opacity: 0; transform: translateX(-20px); }
      to   { opacity: 1; transform: translateX(0); }
    }

    /* ── 背景 ── */
    .bg-mesh {
      position: absolute; inset: 0; z-index: 0;
      background:
        radial-gradient(ellipse 600px 500px at 90% 15%, rgba(16,185,129,0.10) 0%, transparent 70%),
        radial-gradient(ellipse 500px 400px at 5% 80%, rgba(167,139,250,0.08) 0%, transparent 70%),
        #050507;
    }

    /* ── 内容层 ── */
    .content {
      position: relative; z-index: 1;
      width: 100%; height: 100%;
      display: flex; flex-direction: column;
      padding: 80px 64px;
    }

    /* ── 顶部标签 ── */
    .section-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; font-weight: 700;
      letter-spacing: 0.25em; text-transform: uppercase;
      color: #10b981;
      animation: fadeIn 0.35s ease 0.05s both;
    }

    /* ── 标题区域（带左绿线） ── */
    .title-block {
      margin-top: 28px;
      border-left: 4px solid #10b981;
      padding-left: 20px;
      animation: slideRight 0.4s cubic-bezier(0.22,1,0.36,1) 0.15s both;
    }

    .slide-title {
      font-size: clamp(36px, 5.5vw, 52px);
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.01em;
      color: #fff;
    }

    /* ── 分隔线 ── */
    .divider {
      width: 56px; height: 2px;
      background: linear-gradient(to right, #10b981, transparent);
      border-radius: 1px;
      margin: 40px 0;
      animation: fadeIn 0.35s ease 0.25s both;
    }

    /* ── Bullets 列表 ── */
    /*
     * {{bullets_html}} 由 Python render 命令注入，格式如下：
     *   <li class="stagger-item">第一条内容</li>
     *   <li class="stagger-item">第二条内容</li>
     *
     * 每条 <li> 由此处的 CSS 负责动画和样式。
     */
    .bullets-list {
      list-style: none;
      display: flex; flex-direction: column;
      gap: 20px;
      flex: 1;
    }

    /* stagger 动画 */
    .bullets-list .stagger-item {
      display: flex; align-items: flex-start; gap: 16px;
      padding: 22px 24px;
      background: rgba(255,255,255,0.035);
      border: 1px solid rgba(255,255,255,0.07);
      border-radius: 14px;
      font-size: clamp(16px, 2.8vw, 20px);
      font-weight: 400;
      line-height: 1.65;
      color: rgba(255,255,255,0.88);
      animation: fadeUp 0.4s cubic-bezier(0.22,1,0.36,1) both;
      position: relative;
    }

    /* 每条 bullet 的序号圆点 — 通过 counter 实现 */
    .bullets-list {
      counter-reset: bullet-counter;
    }

    .bullets-list .stagger-item::before {
      counter-increment: bullet-counter;
      content: counter(bullet-counter);
      flex-shrink: 0;
      width: 28px; height: 28px;
      border-radius: 50%;
      background: rgba(16,185,129,0.15);
      border: 1px solid rgba(16,185,129,0.4);
      display: flex; align-items: center; justify-content: center;
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px; font-weight: 700;
      color: #10b981;
      margin-top: 1px;
      flex: 0 0 28px;
    }

    /* stagger delay */
    .bullets-list .stagger-item:nth-child(1) { animation-delay: 0.20s; }
    .bullets-list .stagger-item:nth-child(2) { animation-delay: 0.35s; }
    .bullets-list .stagger-item:nth-child(3) { animation-delay: 0.50s; }
    .bullets-list .stagger-item:nth-child(4) { animation-delay: 0.65s; }
    .bullets-list .stagger-item:nth-child(5) { animation-delay: 0.80s; }

    /* ── 底部品牌 ── */
    .brand-footer {
      margin-top: 40px;
      display: flex; align-items: center; gap: 12px;
      animation: fadeIn 0.4s ease 0.9s both;
    }
    .brand-w {
      font-family: 'JetBrains Mono', monospace;
      font-size: 18px; font-weight: 700; color: #10b981;
    }
    .brand-name {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px; font-weight: 600;
      letter-spacing: 0.3em; color: rgba(255,255,255,0.3);
      text-transform: uppercase;
    }

    /* ── debug ── */
    .duration-debug {
      position: absolute; bottom: 12px; right: 20px; z-index: 99;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; color: rgba(255,255,255,0.12);
    }
  </style>
</head>
<body>
  <div style="width:1080px;height:1920px;position:relative;overflow:hidden;">

    <div class="bg-mesh"></div>

    <div class="content">

      <!-- 顶部标签 -->
      <div class="section-tag">要点 · KEY POINTS</div>

      <!-- 标题（带左绿线） -->
      <div class="title-block">
        <div class="slide-title">{{title}}</div>
      </div>

      <!-- 分隔线 -->
      <div class="divider"></div>

      <!-- Bullets 列表
           {{bullets_html}} 由 Python 注入，每条格式：
           <li class="stagger-item">内容文字</li>
      -->
      <ul class="bullets-list">
        {{bullets_html}}
      </ul>

      <!-- 底部品牌 -->
      <div class="brand-footer">
        <div class="brand-w">W</div>
        <div class="brand-name">WEELUME</div>
      </div>

    </div>

    <div class="duration-debug">{{DURATION_MS}}ms</div>

  </div>
</body>
</html>
