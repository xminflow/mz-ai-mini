<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1080, height=1920, initial-scale=1.0">
  <title>slide-compare</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'bg-base': '#050507',
            'accent':  '#10b981',
            'purple':  '#A78BFA',
            'cyan':    '#22d3ee',
          },
          fontFamily: {
            sans: ['AlibabaPuHuiTi', 'PingFang SC', 'Microsoft YaHei', 'sans-serif'],
            mono: ['JetBrains Mono', 'Courier New', 'monospace'],
          },
        },
      },
    };
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    @font-face {
      font-family: 'AlibabaPuHuiTi';
      font-weight: 400;
      src: url('https://cdn.jsdelivr.net/npm/@alifd/fonts@1.0.1/AlibabaPuHuiTi-3/AlibabaPuHuiTi-3-55-Regular/AlibabaPuHuiTi-3-55-Regular.woff2') format('woff2');
      font-display: swap;
    }
    @font-face {
      font-family: 'AlibabaPuHuiTi';
      font-weight: 700;
      src: url('https://cdn.jsdelivr.net/npm/@alifd/fonts@1.0.1/AlibabaPuHuiTi-3/AlibabaPuHuiTi-3-75-SemiBold/AlibabaPuHuiTi-3-75-SemiBold.woff2') format('woff2');
      font-display: swap;
    }
    @font-face {
      font-family: 'AlibabaPuHuiTi';
      font-weight: 800;
      src: url('https://cdn.jsdelivr.net/npm/@alifd/fonts@1.0.1/AlibabaPuHuiTi-3/AlibabaPuHuiTi-3-85-Bold/AlibabaPuHuiTi-3-85-Bold.woff2') format('woff2');
      font-display: swap;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 1080px; height: 1920px;
      overflow: hidden;
      background: #050507;
      color: #fff;
      font-family: 'AlibabaPuHuiTi', 'PingFang SC', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ── 关键帧 ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(30px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    @keyframes slideDown {
      from { opacity: 0; transform: translateY(-20px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes arrowBounce {
      0%, 100% { transform: translateY(0); opacity: 0.7; }
      50%       { transform: translateY(6px); opacity: 1; }
    }

    /* ── 背景 ── */
    .bg-mesh {
      position: absolute; inset: 0; z-index: 0;
      background:
        radial-gradient(ellipse 600px 500px at 85% 10%, rgba(167,139,250,0.10) 0%, transparent 70%),
        radial-gradient(ellipse 500px 600px at 10% 85%, rgba(16,185,129,0.10) 0%, transparent 70%),
        #050507;
    }

    /* ── 内容层 ── */
    .content {
      position: relative; z-index: 1;
      width: 100%; height: 100%;
      display: flex; flex-direction: column;
      padding: 80px 64px;
    }

    /* ── 顶部标签 ── */
    .section-tag {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; font-weight: 700;
      letter-spacing: 0.25em; text-transform: uppercase;
      color: rgba(255,255,255,0.3);
      animation: fadeIn 0.35s ease 0.05s both;
    }

    /* ── 主标题 ── */
    .slide-title {
      font-size: clamp(36px, 5.2vw, 48px);
      font-weight: 800;
      line-height: 1.2;
      letter-spacing: -0.01em;
      margin-top: 24px;
      animation: fadeUp 0.4s cubic-bezier(0.22,1,0.36,1) 0.12s both;
    }

    /* ── 分隔线 ── */
    .divider {
      width: 56px; height: 2px;
      background: linear-gradient(to right, #10b981, transparent);
      border-radius: 1px;
      margin: 32px 0;
      animation: fadeIn 0.35s ease 0.22s both;
    }

    /* ── 对照区域 ── */
    .compare-wrapper {
      flex: 1;
      display: flex; flex-direction: column;
      justify-content: center;
      gap: 0;
    }

    /* ── Before 卡片 ── */
    .compare-card-before {
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.10);
      border-radius: 18px 18px 0 0;
      padding: 28px 32px;
      animation: slideDown 0.45s cubic-bezier(0.22,1,0.36,1) 0.30s both;
    }

    /* ── 箭头 ── */
    .compare-arrow {
      display: flex; align-items: center; justify-content: center;
      height: 56px;
      font-size: 28px;
      color: rgba(16,185,129,0.55);
      background: rgba(255,255,255,0.02);
      border-left: 1px solid rgba(255,255,255,0.06);
      border-right: 1px solid rgba(255,255,255,0.06);
      animation: fadeIn 0.3s ease 0.52s both;
    }

    .compare-arrow span {
      animation: arrowBounce 1.6s ease-in-out 0.8s infinite;
      display: inline-block;
    }

    /* ── After 卡片 ── */
    .compare-card-after {
      background: rgba(16,185,129,0.08);
      border: 1px solid rgba(16,185,129,0.28);
      border-radius: 0 0 18px 18px;
      padding: 28px 32px;
      animation: fadeUp 0.45s cubic-bezier(0.22,1,0.36,1) 0.55s both;
    }

    /* ── 卡片内标签 ── */
    .card-label {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; font-weight: 700;
      letter-spacing: 0.2em; text-transform: uppercase;
      margin-bottom: 14px;
    }

    .card-label-before { color: rgba(255,255,255,0.35); }
    .card-label-after  { color: #10b981; }

    /* ── 卡片正文 ── */
    .card-text {
      font-size: clamp(16px, 2.8vw, 20px);
      font-weight: 400;
      line-height: 1.7;
    }

    .card-text-before { color: rgba(255,255,255,0.65); }
    .card-text-after  { color: rgba(255,255,255,0.92); }

    /* ── 底部品牌 ── */
    .brand-footer {
      margin-top: 40px;
      display: flex; align-items: center; gap: 12px;
      animation: fadeIn 0.4s ease 0.85s both;
    }
    .brand-w {
      font-family: 'JetBrains Mono', monospace;
      font-size: 18px; font-weight: 700; color: #10b981;
    }
    .brand-name {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px; font-weight: 600;
      letter-spacing: 0.3em; color: rgba(255,255,255,0.3);
      text-transform: uppercase;
    }

    /* ── debug ── */
    .duration-debug {
      position: absolute; bottom: 12px; right: 20px; z-index: 99;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; color: rgba(255,255,255,0.12);
    }
  </style>
</head>
<body>
  <div style="width:1080px;height:1920px;position:relative;overflow:hidden;">

    <div class="bg-mesh"></div>

    <div class="content">

      <!-- 顶部标签 -->
      <div class="section-tag">对照 · COMPARE</div>

      <!-- 主标题 -->
      <div class="slide-title">{{title}}</div>

      <!-- 分隔线 -->
      <div class="divider"></div>

      <!-- 对照区 -->
      <div class="compare-wrapper">

        <!-- Before 卡片 -->
        <div class="compare-card-before">
          <div class="card-label card-label-before">早期 / 弱点</div>
          <div class="card-text card-text-before">{{compare_before}}</div>
        </div>

        <!-- 箭头 -->
        <div class="compare-arrow">
          <span>⬇</span>
        </div>

        <!-- After 卡片 -->
        <div class="compare-card-after">
          <div class="card-label card-label-after">近期 / 建议</div>
          <div class="card-text card-text-after">{{compare_after}}</div>
        </div>

      </div>

      <!-- 底部品牌 -->
      <div class="brand-footer">
        <div class="brand-w">W</div>
        <div class="brand-name">WEELUME</div>
      </div>

    </div>

    <div class="duration-debug">{{DURATION_MS}}ms</div>

  </div>
</body>
</html>
