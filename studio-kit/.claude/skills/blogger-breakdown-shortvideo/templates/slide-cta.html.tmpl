<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1080, height=1920, initial-scale=1.0">
  <title>slide-cta — WEELUME</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'bg-base': '#050507',
            'accent':  '#10b981',
            'purple':  '#A78BFA',
            'cyan':    '#22d3ee',
          },
          fontFamily: {
            sans: ['AlibabaPuHuiTi', 'PingFang SC', 'Microsoft YaHei', 'sans-serif'],
            mono: ['JetBrains Mono', 'Courier New', 'monospace'],
          },
        },
      },
    };
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    @font-face {
      font-family: 'AlibabaPuHuiTi';
      font-weight: 400;
      src: url('https://cdn.jsdelivr.net/npm/@alifd/fonts@1.0.1/AlibabaPuHuiTi-3/AlibabaPuHuiTi-3-55-Regular/AlibabaPuHuiTi-3-55-Regular.woff2') format('woff2');
      font-display: swap;
    }
    @font-face {
      font-family: 'AlibabaPuHuiTi';
      font-weight: 700;
      src: url('https://cdn.jsdelivr.net/npm/@alifd/fonts@1.0.1/AlibabaPuHuiTi-3/AlibabaPuHuiTi-3-75-SemiBold/AlibabaPuHuiTi-3-75-SemiBold.woff2') format('woff2');
      font-display: swap;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 1080px; height: 1920px;
      overflow: hidden;
      background: #050507;
      color: #fff;
      font-family: 'AlibabaPuHuiTi', 'PingFang SC', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ── 关键帧 ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.6); }
      to   { opacity: 1; transform: scale(1); }
    }
    @keyframes glowPulse {
      0%, 100% { opacity: 0.35; transform: scale(1); }
      50%       { opacity: 0.55; transform: scale(1.05); }
    }
    @keyframes arrowSlide {
      0%, 100% { transform: translateX(0); }
      50%       { transform: translateX(6px); }
    }

    /* ── 深色渐变背景 ── */
    .bg-gradient {
      position: absolute; inset: 0; z-index: 0;
      background:
        radial-gradient(ellipse 700px 700px at 50% 45%, rgba(16,185,129,0.12) 0%, transparent 65%),
        radial-gradient(ellipse 400px 400px at 20% 20%, rgba(167,139,250,0.10) 0%, transparent 70%),
        radial-gradient(ellipse 350px 350px at 80% 75%, rgba(34,211,238,0.08) 0%, transparent 70%),
        linear-gradient(180deg, #050507 0%, #070a0e 50%, #050507 100%);
    }

    /* ── 装饰格线（更稀疏） ── */
    .bg-grid {
      position: absolute; inset: 0; z-index: 0;
      background-image:
        linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
      background-size: 120px 120px;
    }

    /* ── 中央光晕（纯装饰） ── */
    .center-glow {
      position: absolute;
      width: 600px; height: 600px;
      left: 50%; top: 50%;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      background: radial-gradient(circle, rgba(16,185,129,0.08) 0%, transparent 70%);
      z-index: 0;
      animation: glowPulse 3s ease-in-out 1s infinite;
    }

    /* ── 内容层 ── */
    .content {
      position: relative; z-index: 1;
      width: 100%; height: 100%;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 80px 72px;
      text-align: center;
    }

    /* ── 大 W 字母 ── */
    .logo-w {
      font-family: 'JetBrains Mono', monospace;
      font-size: 96px;
      font-weight: 700;
      color: #10b981;
      line-height: 1;
      animation: scaleIn 0.55s cubic-bezier(0.34,1.56,0.64,1) 0.1s both;
      text-shadow: 0 0 60px rgba(16,185,129,0.4);
    }

    /* ── WEELUME 字样 ── */
    .brand-wordmark {
      font-family: 'JetBrains Mono', monospace;
      font-size: 32px;
      font-weight: 700;
      letter-spacing: 0.55em;
      color: rgba(255,255,255,0.9);
      margin-top: 20px;
      text-transform: uppercase;
      animation: fadeUp 0.4s cubic-bezier(0.22,1,0.36,1) 0.4s both;
    }

    /* ── 装饰分隔 ── */
    .center-divider {
      width: 80px; height: 1px;
      background: linear-gradient(to right, transparent, #10b981, transparent);
      margin: 36px auto;
      animation: fadeIn 0.4s ease 0.55s both;
    }

    /* ── 副标题 ── */
    .brand-subtitle {
      font-size: 20px;
      font-weight: 400;
      letter-spacing: 0.15em;
      color: rgba(255,255,255,0.5);
      animation: fadeUp 0.4s cubic-bezier(0.22,1,0.36,1) 0.65s both;
    }

    .brand-subtitle .dot {
      color: #10b981;
      margin: 0 6px;
    }

    /* ── 底部 CTA 块 ── */
    .cta-block {
      margin-top: 80px;
      display: flex; flex-direction: column;
      align-items: center; gap: 16px;
      animation: fadeUp 0.4s cubic-bezier(0.22,1,0.36,1) 0.80s both;
    }

    .cta-link-row {
      display: flex; align-items: center; gap: 10px;
    }

    .cta-label {
      font-size: 18px;
      font-weight: 600;
      color: rgba(255,255,255,0.75);
      letter-spacing: 0.05em;
    }

    .cta-arrow {
      font-size: 18px;
      color: #10b981;
      animation: arrowSlide 1.4s ease-in-out 1.2s infinite;
      display: inline-block;
    }

    .cta-url {
      font-family: 'JetBrains Mono', monospace;
      font-size: 16px;
      font-weight: 600;
      color: #10b981;
      letter-spacing: 0.08em;
    }

    /* ── 底部装饰点 ── */
    .dot-row {
      position: absolute; bottom: 72px; left: 0; right: 0;
      display: flex; justify-content: center; align-items: center; gap: 8px;
      animation: fadeIn 0.4s ease 1.0s both;
    }

    .dot {
      width: 6px; height: 6px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
    }

    .dot.active { background: #10b981; }

    /* ── debug ── */
    .duration-debug {
      position: absolute; bottom: 12px; right: 20px; z-index: 99;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; color: rgba(255,255,255,0.12);
    }
  </style>
</head>
<body>
  <div style="width:1080px;height:1920px;position:relative;overflow:hidden;">

    <!-- 背景层 -->
    <div class="bg-gradient"></div>
    <div class="bg-grid"></div>
    <div class="center-glow"></div>

    <!-- 中央内容 -->
    <div class="content">

      <!-- 大 W -->
      <div class="logo-w">W</div>

      <!-- WEELUME 字样 -->
      <div class="brand-wordmark">WEELUME</div>

      <!-- 装饰线 -->
      <div class="center-divider"></div>

      <!-- 品牌副标题 -->
      <div class="brand-subtitle">
        真实博主<span class="dot">·</span>真实数据<span class="dot">·</span>真实增长
      </div>

      <!-- 底部 CTA -->
      <div class="cta-block">
        <div class="cta-link-row">
          <span class="cta-label">更多博主拆解报告</span>
          <span class="cta-arrow">→</span>
        </div>
        <div class="cta-url">weelume.com</div>
      </div>

    </div>

    <!-- 底部装饰点 -->
    <div class="dot-row">
      <div class="dot"></div>
      <div class="dot"></div>
      <div class="dot active"></div>
      <div class="dot"></div>
      <div class="dot"></div>
    </div>

    <div class="duration-debug">{{DURATION_MS}}ms</div>

  </div>
</body>
</html>
