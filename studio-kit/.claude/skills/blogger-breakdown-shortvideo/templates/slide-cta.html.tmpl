<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>slide-cta — 微域生光</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      width: 1080px;
      height: 1920px;
      overflow: hidden;
      background: #080808;
      color: #ffffff;
      font-family: 'Microsoft YaHei', 'PingFang SC', SimHei, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ── 关键帧 ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(40px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.55); }
      to   { opacity: 1; transform: scale(1); }
    }
    @keyframes glowPulse {
      0%, 100% { opacity: 0.40; transform: translate(-50%, -50%) scale(1); }
      50%       { opacity: 0.65; transform: translate(-50%, -50%) scale(1.08); }
    }
    @keyframes arrowSlide {
      0%, 100% { transform: translateX(0); }
      50%       { transform: translateX(8px); }
    }
    @keyframes shimmer {
      from { background-position: 200% 0; }
      to   { background-position: -200% 0; }
    }
    @keyframes lineGrow {
      from { transform: scaleX(0); }
      to   { transform: scaleX(1); }
    }

    /* ── 背景层 ── */
    .bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }

    /* 多层径向渐变 */
    .bg-gradient {
      position: absolute; inset: 0;
      background:
        radial-gradient(ellipse 800px 700px at 50% 46%, rgba(201,162,39,0.12) 0%, transparent 62%),
        radial-gradient(ellipse 500px 500px at 18% 22%, rgba(180,100,20,0.10) 0%, transparent 68%),
        radial-gradient(ellipse 420px 420px at 82% 72%, rgba(201,162,39,0.09) 0%, transparent 68%),
        radial-gradient(ellipse 360px 300px at 70% 12%, rgba(240,160,20,0.07) 0%, transparent 68%),
        linear-gradient(160deg, #080808 0%, #0c0a04 50%, #080808 100%);
    }

    /* 细网格 */
    .bg-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(201,162,39,0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(201,162,39,0.04) 1px, transparent 1px);
      background-size: 120px 120px;
    }

    /* 中央呼吸金色光效 */
    .bg-glow-pulse {
      position: absolute;
      width: 700px; height: 700px;
      top: 50%; left: 50%;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(201,162,39,0.14) 0%, rgba(201,162,39,0.04) 40%, transparent 65%);
      animation: glowPulse 3.5s ease-in-out 0.8s infinite;
    }

    /* 斜线装饰 */
    .bg-beam {
      position: absolute;
      width: 2px; border-radius: 2px;
      background: linear-gradient(to bottom, transparent, rgba(201,162,39,0.08), transparent);
      transform-origin: top center;
    }
    .bg-beam-1 { height: 1600px; left: 200px; top: 0; transform: rotate(18deg); }
    .bg-beam-2 { height: 1400px; right: 200px; top: 100px; transform: rotate(-15deg); opacity: 0.6; }
    .bg-beam-3 { height: 1200px; left: 540px; top: 50px; transform: rotate(5deg); opacity: 0.35; }

    /* ── 角落 L 形装饰 ── */
    .corner {
      position: absolute;
      width: 28px; height: 28px;
      border-color: #c9a227;
      border-style: solid;
      z-index: 3;
    }
    .corner-tl { top: 52px;    left: 52px;    border-width: 2px 0 0 2px; }
    .corner-tr { top: 52px;    right: 52px;   border-width: 2px 2px 0 0; }
    .corner-bl { bottom: 52px; left: 52px;    border-width: 0 0 2px 2px; }
    .corner-br { bottom: 52px; right: 52px;   border-width: 0 2px 2px 0; }

    /* ── 整体布局 ── */
    .root {
      width: 1080px; height: 1920px;
      position: relative; overflow: hidden;
    }

    /* ── 中央内容区域（绝对居中） ── */
    .content {
      position: absolute; inset: 0;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      text-align: center;
      z-index: 2;
      gap: 0;
    }

    /* 大 W 字母 */
    .logo-w {
      font-family: Consolas, 'Courier New', monospace;
      font-size: 160px; font-weight: 700;
      color: #c9a227; line-height: 1;
      text-shadow:
        0 0 30px rgba(201,162,39,0.55),
        0 0 70px rgba(201,162,39,0.25),
        0 0 120px rgba(201,162,39,0.12);
      animation: scaleIn 0.65s cubic-bezier(0.34,1.56,0.64,1) 0.12s both;
    }

    /* 微域生光 字样（品牌中文名，主品牌符号） */
    .brand-wordmark {
      font-family: 'Microsoft YaHei', 'PingFang SC', SimHei, sans-serif;
      font-size: 64px; font-weight: 700;
      letter-spacing: 0.18em;
      color: rgba(255,255,255,0.94);
      margin-top: 28px;
      animation: fadeUp 0.5s cubic-bezier(0.22,1,0.36,1) 0.42s both;
    }

    /* 装饰细横线 */
    .center-divider {
      width: 100px; height: 1.5px;
      background: linear-gradient(to right, transparent, #f0d060, #c9a227, #f0d060, transparent);
      background-size: 200% 100%;
      margin: 40px auto;
      transform-origin: center;
      animation:
        lineGrow 0.5s cubic-bezier(0.22,1,0.36,1) 0.58s both,
        shimmer  2.5s 1.2s linear infinite;
    }

    /* 副标题 */
    .brand-subtitle {
      font-size: 38px; font-weight: 400;
      letter-spacing: 0.14em;
      color: rgba(255,255,255,0.48);
      animation: fadeUp 0.5s cubic-bezier(0.22,1,0.36,1) 0.68s both;
    }
    .brand-subtitle .dot-sep {
      color: #c9a227;
      margin: 0 8px;
    }

    /* CTA 块 */
    .cta-block {
      margin-top: 96px;
      display: flex; flex-direction: column;
      align-items: center; gap: 18px;
      animation: fadeUp 0.5s cubic-bezier(0.22,1,0.36,1) 0.82s both;
    }

    .cta-row {
      display: flex; align-items: center; gap: 12px;
    }

    .cta-label {
      font-size: 38px; font-weight: 600;
      color: rgba(255,255,255,0.78);
      letter-spacing: 0.06em;
    }

    .cta-arrow {
      font-size: 38px; color: #c9a227;
      display: inline-block;
      animation: arrowSlide 1.6s ease-in-out 1.4s infinite;
    }

    .cta-url {
      font-family: Consolas, 'Courier New', monospace;
      font-size: 40px; font-weight: 600;
      color: #c9a227; letter-spacing: 0.10em;
    }

    /* ── 底部装饰圆点 ── */
    .dot-row {
      position: absolute; bottom: 82px; left: 0; right: 0;
      display: flex; justify-content: center; align-items: center; gap: 10px;
      z-index: 3;
      animation: fadeIn 0.5s ease 1.05s both;
    }
    .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: rgba(255,255,255,0.14);
    }
    .dot.active {
      background: #c9a227;
      box-shadow: 0 0 10px rgba(201,162,39,0.6);
    }

    .duration-debug {
      position: absolute; bottom: 14px; right: 22px; z-index: 99;
      font-family: Consolas, 'Courier New', monospace;
      font-size: 10px; color: rgba(255,255,255,0.12);
    }
  </style>
</head>
<body>
  <div class="root">
    <!-- 背景 -->
    <div class="bg" aria-hidden="true">
      <div class="bg-gradient"></div>
      <div class="bg-grid"></div>
      <div class="bg-glow-pulse"></div>
      <div class="bg-beam bg-beam-1"></div>
      <div class="bg-beam bg-beam-2"></div>
      <div class="bg-beam bg-beam-3"></div>
    </div>

    <!-- 角落装饰 -->
    <div class="corner corner-tl" aria-hidden="true"></div>
    <div class="corner corner-tr" aria-hidden="true"></div>
    <div class="corner corner-bl" aria-hidden="true"></div>
    <div class="corner corner-br" aria-hidden="true"></div>

    <!-- 中央内容 -->
    <div class="content">
      <div class="logo-w">W</div>
      <div class="brand-wordmark">微域生光</div>
      <div class="center-divider" aria-hidden="true"></div>
      <div class="brand-subtitle">
        真实博主<span class="dot-sep">·</span>真实数据<span class="dot-sep">·</span>真实增长
      </div>
      <div class="cta-block">
        <div class="cta-row">
          <span class="cta-label">更多博主拆解报告</span>
          <span class="cta-arrow">&#8594;</span>
        </div>
        <div class="cta-url">微域生光</div>
      </div>
    </div>

    <!-- 底部装饰圆点（4灰1金） -->
    <div class="dot-row" aria-hidden="true">
      <div class="dot"></div>
      <div class="dot"></div>
      <div class="dot active"></div>
      <div class="dot"></div>
      <div class="dot"></div>
    </div>

    <div class="duration-debug">{{DURATION_MS}}ms</div>
  </div>
</body>
</html>
