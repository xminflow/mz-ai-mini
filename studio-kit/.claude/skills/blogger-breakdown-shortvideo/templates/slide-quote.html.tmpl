<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>slide-quote</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      width: 1080px;
      height: 1920px;
      overflow: hidden;
      background: #080808;
      color: #ffffff;
      font-family: 'Microsoft YaHei', 'PingFang SC', SimHei, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ── 关键帧 ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(40px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    @keyframes lineGrow {
      from { transform: scaleX(0); }
      to   { transform: scaleX(1); }
    }
    @keyframes shimmer {
      from { background-position: 200% 0; }
      to   { background-position: -200% 0; }
    }

    /* ── 背景层 ── */
    .bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }

    /* 中央大金色光晕球 */
    .bg-glow-center {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 1000px; height: 900px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(201,162,39,0.10) 0%, rgba(201,162,39,0.04) 38%, transparent 65%);
    }
    /* 左侧小光晕 */
    .bg-glow-l {
      position: absolute; left: -180px; top: 600px;
      width: 500px; height: 500px; border-radius: 50%;
      background: radial-gradient(circle, rgba(180,100,20,0.12) 0%, transparent 65%);
    }
    /* 右侧小光晕 */
    .bg-glow-r {
      position: absolute; right: -140px; top: 900px;
      width: 440px; height: 440px; border-radius: 50%;
      background: radial-gradient(circle, rgba(201,162,39,0.10) 0%, transparent 65%);
    }
    /* 细网格 */
    .bg-grid {
      position: absolute; inset: 0;
      background-image:
        linear-gradient(rgba(201,162,39,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(201,162,39,0.03) 1px, transparent 1px);
      background-size: 90px 90px;
    }
    /* 斜线装饰 */
    .bg-beam {
      position: absolute;
      width: 2px; height: 1600px;
      background: linear-gradient(to bottom, transparent, rgba(201,162,39,0.06), transparent);
      transform-origin: top center;
    }
    .bg-beam-1 { left: 160px; top: 0; transform: rotate(22deg); }
    .bg-beam-2 { right: 180px; top: 0; transform: rotate(-18deg); opacity: 0.55; }

    /* ── 整体布局 ── */
    .root {
      width: 1080px; height: 1920px;
      position: relative; overflow: hidden;
    }

    /* ── 章节标签（左上角） ── */
    .section-tag {
      position: absolute; top: 88px; left: 76px;
      font-family: Consolas, 'Courier New', monospace;
      font-size: 34px; font-weight: 400;
      letter-spacing: 0.28em; text-transform: uppercase;
      color: rgba(255,255,255,0.22);
      z-index: 1;
      animation: fadeIn 0.4s ease 0.05s both;
    }

    /* ── 中央内容区域 ── */
    .content {
      position: absolute; inset: 0;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 160px 100px;
      text-align: center;
      z-index: 1;
    }

    /* 大装饰引号 */
    .deco-quote {
      position: absolute;
      top: 240px; left: 60px;
      font-family: Consolas, 'Courier New', monospace;
      font-size: 340px;
      font-weight: 700;
      line-height: 1;
      color: #c9a227;
      opacity: 0.10;
      user-select: none;
      pointer-events: none;
      z-index: 0;
    }

    /* 金句正文 */
    .quote-text {
      font-size: 46px;
      font-weight: 700;
      line-height: 1.9;
      color: rgba(255,255,255,0.95);
      max-width: 880px;
      letter-spacing: 0.02em;
      position: relative; z-index: 1;
      animation: fadeUp 0.55s 0.3s cubic-bezier(0.22,1,0.36,1) both;
    }

    /* 中心横线 */
    .center-line {
      width: 160px; height: 2px;
      background: linear-gradient(to right, transparent, #c9a227, #f0d060, #c9a227, transparent);
      background-size: 200% 100%;
      border-radius: 1px;
      margin: 52px auto;
      transform-origin: center center;
      animation:
        lineGrow 0.5s cubic-bezier(0.22,1,0.36,1) 0.55s both,
        shimmer  2.5s 1.1s linear infinite;
    }

    /* 来源标签 */
    .quote-source {
      font-family: Consolas, 'Courier New', monospace;
      font-size: 40px; font-weight: 400;
      letter-spacing: 0.16em;
      color: #c9a227;
      animation: fadeIn 0.45s ease 0.65s both;
    }

    /* ── 底部品牌 ── */
    .brand-footer {
      position: absolute; bottom: 80px; left: 0; right: 0;
      display: flex; justify-content: center; align-items: center; gap: 20px;
      z-index: 1;
      animation: fadeIn 0.45s ease 0.85s both;
    }
    .brand-w {
      font-family: Consolas, 'Courier New', monospace;
      font-size: 44px; font-weight: 700;
      color: #c9a227; line-height: 1;
      text-shadow: 0 0 20px rgba(201,162,39,0.45);
    }
    .brand-name {
      font-family: Consolas, 'Courier New', monospace;
      font-size: 36px; font-weight: 400;
      letter-spacing: 0.52em; color: rgba(255,255,255,0.42);
      text-transform: uppercase;
    }

    .duration-debug {
      position: absolute; bottom: 14px; right: 22px; z-index: 99;
      font-family: Consolas, 'Courier New', monospace;
      font-size: 10px; color: rgba(255,255,255,0.12);
    }
  </style>
</head>
<body>
  <div class="root">
    <!-- 背景 -->
    <div class="bg" aria-hidden="true">
      <div class="bg-glow-center"></div>
      <div class="bg-glow-l"></div>
      <div class="bg-glow-r"></div>
      <div class="bg-grid"></div>
      <div class="bg-beam bg-beam-1"></div>
      <div class="bg-beam bg-beam-2"></div>
    </div>

    <!-- 章节标签 -->
    <div class="section-tag">博主金句 · QUOTE</div>

    <!-- 大装饰引号 -->
    <div class="deco-quote" aria-hidden="true">"</div>

    <!-- 中央内容 -->
    <div class="content">
      <div class="quote-text">{{quote}}</div>
      <div class="center-line" aria-hidden="true"></div>
      <div class="quote-source">{{source}}</div>
    </div>

    <!-- 底部品牌 -->
    <div class="brand-footer">
      <span class="brand-w">W</span>
      <span class="brand-name">微域生光</span>
    </div>

    <div class="duration-debug">{{DURATION_MS}}ms</div>
  </div>
</body>
</html>
