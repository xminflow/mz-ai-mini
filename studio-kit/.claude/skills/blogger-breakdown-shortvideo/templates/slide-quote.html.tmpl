<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1080, height=1920, initial-scale=1.0">
  <title>slide-quote</title>

  <!-- Tailwind CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'bg-base': '#050507',
            'accent':  '#10b981',
            'purple':  '#A78BFA',
            'cyan':    '#22d3ee',
          },
          fontFamily: {
            sans: ['AlibabaPuHuiTi', 'PingFang SC', 'Microsoft YaHei', 'sans-serif'],
            mono: ['JetBrains Mono', 'Courier New', 'monospace'],
          },
        },
      },
    };
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">

  <style>
    @font-face {
      font-family: 'AlibabaPuHuiTi';
      font-weight: 400;
      src: url('https://cdn.jsdelivr.net/npm/@alifd/fonts@1.0.1/AlibabaPuHuiTi-3/AlibabaPuHuiTi-3-55-Regular/AlibabaPuHuiTi-3-55-Regular.woff2') format('woff2');
      font-display: swap;
    }
    @font-face {
      font-family: 'AlibabaPuHuiTi';
      font-weight: 700;
      src: url('https://cdn.jsdelivr.net/npm/@alifd/fonts@1.0.1/AlibabaPuHuiTi-3/AlibabaPuHuiTi-3-75-SemiBold/AlibabaPuHuiTi-3-75-SemiBold.woff2') format('woff2');
      font-display: swap;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 1080px; height: 1920px;
      overflow: hidden;
      background: #050507;
      color: #fff;
      font-family: 'AlibabaPuHuiTi', 'PingFang SC', sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ── 关键帧 ── */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(28px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    @keyframes scaleIn {
      from { opacity: 0; transform: scale(0.7); }
      to   { opacity: 1; transform: scale(1); }
    }
    @keyframes lineExpand {
      from { width: 0; }
      to   { width: 80px; }
    }

    /* ── 背景 ── */
    .bg-mesh {
      position: absolute; inset: 0; z-index: 0;
      background:
        radial-gradient(ellipse 800px 600px at 50% 45%, rgba(16,185,129,0.10) 0%, transparent 65%),
        radial-gradient(ellipse 400px 400px at 15% 20%, rgba(167,139,250,0.10) 0%, transparent 70%),
        radial-gradient(ellipse 400px 400px at 85% 75%, rgba(34,211,238,0.08) 0%, transparent 70%),
        #050507;
    }

    /* ── 整体布局 ── */
    .content {
      position: relative; z-index: 1;
      width: 100%; height: 100%;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 80px 72px;
      text-align: center;
    }

    /* ── 引号图标 ── */
    .quote-mark {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: 160px;
      font-weight: 900;
      line-height: 0.8;
      color: #10b981;
      opacity: 0.22;
      user-select: none;
      margin-bottom: -20px;
      animation: scaleIn 0.5s cubic-bezier(0.34,1.56,0.64,1) 0s both;
    }

    /* ── 金句正文 ── */
    .quote-text {
      font-size: clamp(22px, 3.8vw, 32px);
      font-weight: 700;
      line-height: 1.85;
      color: rgba(255,255,255,0.95);
      letter-spacing: 0.03em;
      max-width: 820px;
      animation: fadeUp 0.45s cubic-bezier(0.22,1,0.36,1) 0.35s both;
    }

    /* ── 装饰分隔线 ── */
    .center-line {
      height: 2px;
      background: linear-gradient(to right, transparent, #10b981, transparent);
      border-radius: 1px;
      margin: 40px auto;
      animation: lineExpand 0.5s cubic-bezier(0.22,1,0.36,1) 0.55s both;
    }

    /* ── 来源标签 ── */
    .quote-source {
      font-family: 'JetBrains Mono', monospace;
      font-size: 14px; font-weight: 600;
      letter-spacing: 0.12em;
      color: #10b981;
      opacity: 0.8;
      animation: fadeIn 0.4s ease 0.65s both;
    }

    /* ── 章节标签（左上） ── */
    .section-tag {
      position: absolute; top: 80px; left: 72px;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px; font-weight: 700;
      letter-spacing: 0.25em; text-transform: uppercase;
      color: rgba(255,255,255,0.25);
      animation: fadeIn 0.35s ease 0.1s both;
    }

    /* ── 底部品牌 ── */
    .brand-footer {
      position: absolute; bottom: 72px; left: 0; right: 0;
      display: flex; justify-content: center; align-items: center; gap: 12px;
      animation: fadeIn 0.4s ease 0.8s both;
    }
    .brand-w {
      font-family: 'JetBrains Mono', monospace;
      font-size: 18px; font-weight: 700; color: #10b981;
    }
    .brand-name {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px; font-weight: 600;
      letter-spacing: 0.3em; color: rgba(255,255,255,0.3);
      text-transform: uppercase;
    }

    /* ── debug ── */
    .duration-debug {
      position: absolute; bottom: 12px; right: 20px; z-index: 99;
      font-family: 'JetBrains Mono', monospace;
      font-size: 10px; color: rgba(255,255,255,0.12);
    }
  </style>
</head>
<body>
  <div style="width:1080px;height:1920px;position:relative;overflow:hidden;">

    <div class="bg-mesh"></div>

    <!-- 左上角标签 -->
    <div class="section-tag">博主金句 · QUOTE</div>

    <!-- 中央内容 -->
    <div class="content">

      <!-- 巨大引号 -->
      <div class="quote-mark">"</div>

      <!-- 金句正文 -->
      <div class="quote-text">{{quote}}</div>

      <!-- 分隔线 -->
      <div class="center-line" style="width:80px;"></div>

      <!-- 来源标签 -->
      <div class="quote-source">{{source}}</div>

    </div>

    <!-- 底部品牌 -->
    <div class="brand-footer">
      <div class="brand-w">W</div>
      <div class="brand-name">WEELUME</div>
    </div>

    <div class="duration-debug">{{DURATION_MS}}ms</div>

  </div>
</body>
</html>
