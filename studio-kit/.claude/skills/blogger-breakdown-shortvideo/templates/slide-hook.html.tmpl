<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <title>slide-hook</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      width: 1080px;
      height: 1920px;
      overflow: hidden;
      background: #080808;
      color: #ffffff;
      font-family: 'Microsoft YaHei', 'PingFang SC', SimHei, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    /* ── 关键帧 ── */
    @keyframes punchIn {
      0%   { opacity: 0; transform: scale(1.42); filter: brightness(2.0); }
      55%  { opacity: 1; transform: scale(0.98); filter: brightness(1.1); }
      100% { opacity: 1; transform: scale(1.00); filter: brightness(1.0); }
    }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(28px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes shimmer {
      from { background-position: 200% 0; }
      to   { background-position: -200% 0; }
    }
    @keyframes scanline {
      0%, 100% { opacity: 0.0; transform: translateY(-60vh); }
      50%      { opacity: 1.0; transform: translateY(60vh); }
    }

    /* ── 背景：极简，纯黑+一条扫描线 ── */
    .bg {
      position: absolute; inset: 0; z-index: 0; pointer-events: none;
    }
    .bg-vignette {
      position: absolute; inset: 0;
      background: radial-gradient(ellipse at center, transparent 35%, rgba(0,0,0,0.55) 92%);
    }
    .bg-scan {
      position: absolute; left: 0; right: 0; height: 240px;
      background: linear-gradient(to bottom, transparent, rgba(240,208,96,0.05), transparent);
      animation: scanline 6s ease-in-out infinite;
    }

    /* ── 角落 L 形装饰（与 cover 同款，保持品牌一致） ── */
    .corner {
      position: absolute;
      width: 28px; height: 28px;
      border-color: #c9a227;
      border-style: solid;
      z-index: 3;
    }
    .corner-tl { top: 52px;    left: 52px;    border-width: 2px 0 0 2px; }
    .corner-tr { top: 52px;    right: 52px;   border-width: 2px 2px 0 0; }
    .corner-bl { bottom: 52px; left: 52px;    border-width: 0 0 2px 2px; }
    .corner-br { bottom: 52px; right: 52px;   border-width: 0 2px 2px 0; }

    /* ── 整体容器 ── */
    .root {
      width: 1080px; height: 1920px;
      position: relative; overflow: hidden;
      display: flex; flex-direction: column;
      justify-content: center; align-items: center;
      padding: 88px 76px;
    }

    /* ── 顶部 hook 标签 ── */
    .hook-tag {
      position: absolute; top: 180px; left: 0; right: 0;
      text-align: center;
      font-family: Consolas, 'Courier New', monospace;
      font-size: 36px;
      font-weight: 400;
      color: rgba(240,208,96,0.85);
      letter-spacing: 0.5em;
      text-transform: uppercase;
      animation: fadeUp 0.4s ease 0.0s both;
    }
    .hook-tag::before, .hook-tag::after {
      content: '—';
      margin: 0 22px;
      color: rgba(240,208,96,0.45);
    }

    /* ── 中央大字 ── */
    .hook-big {
      font-size: 200px;
      font-weight: 900;
      line-height: 0.96;
      letter-spacing: -0.03em;
      color: #f0d060;
      text-align: center;
      max-width: 920px;
      text-shadow:
        0 0 36px rgba(240,208,96,0.45),
        0 0 96px rgba(240,208,96,0.18);
      animation: punchIn 0.45s cubic-bezier(0.22,1,0.36,1) 0.05s both;
      position: relative;
      z-index: 2;
    }
    /* 如果是纯文字（非数字），样式略收，避免溢出 */
    .hook-big.is-text { font-size: 156px; color: #ffffff; }

    /* ── 副标 ── */
    .hook-sub {
      margin-top: 56px;
      font-size: 52px;
      font-weight: 500;
      color: rgba(255,255,255,0.82);
      letter-spacing: 0.02em;
      line-height: 1.4;
      text-align: center;
      max-width: 880px;
      animation: fadeUp 0.45s cubic-bezier(0.22,1,0.36,1) 0.28s both;
      position: relative;
      z-index: 2;
    }

    /* ── 金色下划装饰（在大字下方） ── */
    .hook-underline {
      margin-top: 36px;
      height: 6px;
      width: 280px;
      border-radius: 3px;
      background: linear-gradient(to right, transparent, #f0d060, #c9a227, #f0d060, transparent);
      background-size: 300% 100%;
      box-shadow: 0 0 24px rgba(240,208,96,0.45);
      animation: shimmer 2.6s linear 0.6s infinite, fadeUp 0.45s ease 0.2s both;
    }

    /* ── 底部品牌（极简） ── */
    .brand-footer {
      position: absolute;
      bottom: 110px; left: 0; right: 0;
      display: flex; justify-content: center; align-items: center;
      gap: 18px;
      animation: fadeUp 0.45s ease 0.55s both;
    }
    .brand-w {
      font-family: Consolas, 'Courier New', monospace;
      font-size: 46px; font-weight: 700;
      color: #c9a227; line-height: 1;
      text-shadow: 0 0 20px rgba(201,162,39,0.45);
    }
    .brand-name {
      font-family: Consolas, 'Courier New', monospace;
      font-size: 36px; font-weight: 400;
      letter-spacing: 0.52em; color: rgba(255,255,255,0.42);
      text-transform: uppercase;
    }

    .duration-debug {
      position: absolute; bottom: 14px; right: 22px; z-index: 99;
      font-family: Consolas, 'Courier New', monospace;
      font-size: 10px; color: rgba(255,255,255,0.12);
    }
  </style>
</head>
<body>
  <div class="root">
    <!-- 背景 -->
    <div class="bg" aria-hidden="true">
      <div class="bg-vignette"></div>
      <div class="bg-scan"></div>
    </div>

    <!-- 角落装饰 -->
    <div class="corner corner-tl" aria-hidden="true"></div>
    <div class="corner corner-tr" aria-hidden="true"></div>
    <div class="corner corner-bl" aria-hidden="true"></div>
    <div class="corner corner-br" aria-hidden="true"></div>

    <!-- HOOK 标签 -->
    <div class="hook-tag">HOOK</div>

    <!-- 中央大字 -->
    <div class="hook-big" id="hookBig">{{hook_big_text}}</div>
    <div class="hook-underline" aria-hidden="true"></div>
    <div class="hook-sub">{{hook_sub_text}}</div>

    <!-- 底部品牌 -->
    <div class="brand-footer">
      <span class="brand-w">W</span>
      <span class="brand-name">微域生光</span>
    </div>

    <div class="duration-debug">{{DURATION_MS}}ms</div>
  </div>

  <script>
    // 若 hook_big_text 不含数字 / 货币符号 / % / × / 倍 / 万 / 亿，视作纯文字，缩小字号
    (function(){
      var el = document.getElementById('hookBig');
      if (!el) return;
      var t = (el.textContent || '').trim();
      if (!/[0-9¥$%×倍万亿]/.test(t)) {
        el.classList.add('is-text');
      }
    })();
  </script>
</body>
</html>
