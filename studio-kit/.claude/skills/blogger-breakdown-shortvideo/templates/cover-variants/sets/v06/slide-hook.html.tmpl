<!DOCTYPE html>
<html lang="zh-CN">
<!-- v06 多窗口分屏 · slide-hook · 左 60% 巨数字 panel + 进度条/柱状微动效，右 40% 文字 panel + 脉冲圆点装饰 -->
<head>
  <meta charset="UTF-8">
  <title>slide-hook</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 1080px; height: 1920px; overflow: hidden;
      background: #080808; color: #fff;
      font-family: 'Microsoft YaHei', 'PingFang SC', SimHei, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .stage {
      position: relative; width: 1080px; height: 1920px;
      background:
        radial-gradient(ellipse at 25% 30%, rgba(201,162,39,0.10) 0%, transparent 55%),
        radial-gradient(ellipse at 80% 80%, rgba(180,100,20,0.07) 0%, transparent 60%),
        #080808;
    }

    /* 顶部 ticker */
    .topbar {
      position: absolute; top: 0; left: 0;
      width: 1080px; height: 46px;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 32px;
      border-bottom: 1px solid rgba(201,162,39,0.35);
      background: rgba(8,8,8,0.6);
      z-index: 10;
      font-family: 'Inter', system-ui, sans-serif;
      font-size: 14px; letter-spacing: 0.18em;
      color: rgba(232,196,107,0.9);
    }
    .topbar .dot {
      display: inline-block; width: 8px; height: 8px;
      background: #c9a227; border-radius: 50%;
      margin-right: 10px; animation: blink 1.4s infinite;
    }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.25} }

    /* 2 panel grid */
    .grid {
      position: absolute; top: 46px; left: 0;
      width: 1080px; height: 1874px;
    }

    .panel {
      position: absolute;
      background: rgba(14,14,14,0.6);
      border: 1px solid rgba(201,162,39,0.45);
      overflow: hidden;
      opacity: 0; transform: translateY(24px);
      animation: panelIn 0.55s cubic-bezier(.2,.7,.2,1) forwards;
    }
    @keyframes panelIn { to { opacity: 1; transform: translateY(0); } }

    .panel .label {
      position: absolute; top: 28px; left: 32px;
      font-size: 22px; letter-spacing: 0.28em;
      color: rgba(232,196,107,0.78);
      font-family: 'Inter', system-ui, sans-serif;
    }
    .panel .tag {
      position: absolute; top: 28px; right: 32px;
      font-size: 16px; letter-spacing: 0.22em;
      color: rgba(255,255,255,0.4);
      font-family: 'Inter', system-ui, sans-serif;
    }

    /* P-big 左 60%：超大 hook 数字 + 进度条 + 底部柱状 */
    .p-big {
      left: 0; top: 0;
      width: 648px; height: 1874px;
      animation-delay: 0ms;
      background:
        linear-gradient(135deg, rgba(201,162,39,0.08) 0%, rgba(8,8,8,0) 60%),
        rgba(14,14,14,0.72);
    }
    .p-big .hook-big {
      position: absolute; left: 48px; right: 48px; top: 460px;
      font-size: 200px; font-weight: 900;
      color: #f0d060;
      line-height: 0.96;
      letter-spacing: -0.03em;
      text-shadow:
        0 0 40px rgba(240,208,96,0.45),
        0 0 100px rgba(240,208,96,0.18);
      word-break: break-all;
      opacity: 0; transform: scale(1.3);
      animation: punchIn 0.55s cubic-bezier(.2,.7,.2,1) 0.35s forwards;
    }
    @keyframes punchIn {
      0% { opacity: 0; transform: scale(1.3); filter: brightness(1.8); }
      60% { opacity: 1; transform: scale(0.98); filter: brightness(1.1); }
      100% { opacity: 1; transform: scale(1); filter: brightness(1); }
    }
    /* 若是纯文字（非数字）— 由 JS 切到 is-text，缩小字号 */
    .p-big .hook-big.is-text { font-size: 132px; color: #fff; }

    .p-big .hook-underline {
      position: absolute; left: 48px;
      top: 780px;
      width: 280px; height: 6px;
      background: linear-gradient(to right, transparent, #f0d060, #c9a227, #f0d060, transparent);
      background-size: 300% 100%;
      box-shadow: 0 0 24px rgba(240,208,96,0.45);
      opacity: 0;
      animation: shimmer 2.6s linear 1.4s infinite, lineIn 0.5s ease 0.85s forwards;
    }
    @keyframes shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
    @keyframes lineIn { from { opacity: 0; width: 0; } to { opacity: 1; width: 280px; } }

    /* 进度条微动效 */
    .p-big .bar-wrap {
      position: absolute; left: 48px; right: 48px; top: 880px;
      height: 6px; background: rgba(255,255,255,0.08);
    }
    .p-big .bar {
      position: absolute; left: 0; top: 0; height: 100%; width: 0;
      background: linear-gradient(90deg, #c9a227, #e8c46b);
      animation: barFill 1.8s cubic-bezier(.2,.7,.2,1) 1.1s forwards;
    }
    @keyframes barFill { to { width: 92%; } }
    .p-big .bar-meta {
      position: absolute; left: 48px; right: 48px; top: 902px;
      display: flex; justify-content: space-between;
      font-family: 'Inter', system-ui, monospace;
      font-size: 13px; color: rgba(232,196,107,0.7);
      letter-spacing: 0.15em;
    }

    /* 底部柱状（次微动效） */
    .p-big .bars {
      position: absolute; left: 48px; right: 48px; bottom: 80px;
      height: 240px; display: flex; align-items: end; gap: 12px;
    }
    .p-big .bars b {
      flex: 1; background: linear-gradient(180deg, #e8c46b, #c9a227);
      height: 0; animation: barRise 0.9s cubic-bezier(.2,.7,.2,1) forwards;
    }
    .p-big .bars b:nth-child(1){--h:28%;animation-delay:1.4s}
    .p-big .bars b:nth-child(2){--h:42%;animation-delay:1.55s}
    .p-big .bars b:nth-child(3){--h:60%;animation-delay:1.7s}
    .p-big .bars b:nth-child(4){--h:75%;animation-delay:1.85s}
    .p-big .bars b:nth-child(5){--h:88%;animation-delay:2.0s}
    .p-big .bars b:nth-child(6){--h:100%;animation-delay:2.15s}
    @keyframes barRise { to { height: var(--h); } }

    .p-big .id {
      position: absolute; left: 48px; bottom: 36px;
      font-family: 'Inter', system-ui, monospace;
      font-size: 18px; color: #c9a227;
      letter-spacing: 0.15em;
    }
    .p-big .id::before {
      content: ""; display: inline-block;
      width: 30px; height: 1px; background: #c9a227;
      vertical-align: middle; margin-right: 12px;
    }

    /* P-side 右 40%：文字 + 装饰 */
    .p-side {
      left: 648px; top: 0;
      width: 432px; height: 1874px;
      animation-delay: 200ms;
    }
    .p-side .hook-sub {
      position: absolute; left: 36px; right: 36px; top: 460px;
      font-size: 44px; font-weight: 500;
      color: rgba(255,255,255,0.92);
      line-height: 1.5;
      letter-spacing: 0.02em;
      opacity: 0; transform: translateY(20px);
      animation: textIn 0.5s cubic-bezier(.2,.7,.2,1) 0.7s forwards;
    }
    @keyframes textIn { to { opacity: 1; transform: translateY(0); } }

    /* 脉冲圆点 + 装饰 */
    .p-side .pulse {
      position: absolute; right: 60px; top: 280px;
      width: 24px; height: 24px;
    }
    .p-side .pulse::before, .p-side .pulse::after {
      content: ""; position: absolute; inset: 0;
      border-radius: 50%; background: #c9a227;
    }
    .p-side .pulse::after { animation: pulseRing 1.8s ease-out infinite; }
    @keyframes pulseRing { 0%{transform:scale(1);opacity:0.8} 100%{transform:scale(3.6);opacity:0} }

    /* 右侧 strip 装饰 */
    .p-side .strip {
      position: absolute; left: 36px; right: 36px; top: 1080px;
      display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px;
    }
    .p-side .strip span {
      height: 24px; background: rgba(201,162,39,0.25);
      border-left: 1px solid rgba(232,196,107,0.45);
    }
    .p-side .strip span:nth-child(odd) { background: rgba(201,162,39,0.5); }

    .p-side .deco-line {
      position: absolute; left: 36px; right: 36px; top: 760px;
      height: 1px; background: linear-gradient(to right, rgba(201,162,39,0.7), transparent);
    }
    .p-side .deco-line.b {
      top: 800px; width: 60%;
      background: linear-gradient(to right, rgba(201,162,39,0.45), transparent);
    }

    /* 阶梯（末尾装饰） */
    .p-side .stairs {
      position: absolute; left: 36px; right: 36px; bottom: 120px;
      height: 160px; display: flex; align-items: end; gap: 5px;
    }
    .p-side .stairs i {
      flex: 1;
      background: rgba(201,162,39,0.2);
      border: 1px solid rgba(201,162,39,0.5);
      border-bottom: none;
      opacity: 0.25;
      animation: stairOn 0.5s ease-out forwards;
    }
    .p-side .stairs i:nth-child(1){height:20%;animation-delay:1.8s}
    .p-side .stairs i:nth-child(2){height:42%;animation-delay:2.0s}
    .p-side .stairs i:nth-child(3){height:62%;animation-delay:2.2s}
    .p-side .stairs i:nth-child(4){height:82%;animation-delay:2.4s}
    .p-side .stairs i:nth-child(5){height:100%;animation-delay:2.6s;animation-name:stairOnTop}
    @keyframes stairOn { to { opacity: 1; background: rgba(232,196,107,0.55); } }
    @keyframes stairOnTop { to { opacity: 1; background: #e8c46b; box-shadow: 0 0 18px rgba(232,196,107,0.55); } }

    .p-side .tag-line {
      position: absolute; left: 36px; bottom: 50px;
      font-family: 'Inter', system-ui, monospace;
      font-size: 14px; color: rgba(232,196,107,0.7);
      letter-spacing: 0.22em;
    }

    /* 十字接合点 */
    .crosshair {
      position: absolute; width: 14px; height: 14px;
      border: 1px solid #c9a227; background: #080808; z-index: 5;
    }
    .ch1 { left: 641px; top: 39px; }
    .ch2 { left: 641px; top: 1907px; }

    .duration-debug {
      position: absolute; bottom: 14px; right: 22px; z-index: 99;
      font-family: Consolas, 'Courier New', monospace;
      font-size: 10px; color: rgba(255,255,255,0.12);
    }
  </style>
</head>
<body>
<div class="stage">

  <div class="topbar">
    <div><span class="dot"></span>HOOK · {{slide_type}}</div>
    <div>微域生光 · 博主拆解</div>
  </div>

  <div class="grid">

    <!-- 左 60%：超大数字 panel -->
    <div class="panel p-big">
      <div class="label">// HOOK</div>
      <div class="tag">No.{{index}}</div>
      <div class="hook-big" id="hookBig">{{hook_big_text}}</div>
      <div class="hook-underline" aria-hidden="true"></div>
      <div class="bar-wrap"><div class="bar"></div></div>
      <div class="bar-meta"><span>0</span><span>HOOK · LIVE</span><span>92%</span></div>
      <div class="bars"><b></b><b></b><b></b><b></b><b></b><b></b></div>
      <div class="id">真实数据驱动</div>
    </div>

    <!-- 右 40%：副标文字 panel -->
    <div class="panel p-side">
      <div class="label">// NOTE</div>
      <div class="tag">02</div>
      <div class="pulse" aria-hidden="true"></div>
      <div class="hook-sub">{{hook_sub_text}}</div>
      <div class="deco-line" aria-hidden="true"></div>
      <div class="deco-line b" aria-hidden="true"></div>
      <div class="strip" aria-hidden="true">
        <span></span><span></span><span></span><span></span><span></span><span></span>
      </div>
      <div class="stairs" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i>
      </div>
      <div class="tag-line">// 微域生光</div>
    </div>

    <div class="crosshair ch1"></div>
    <div class="crosshair ch2"></div>
  </div>

  <div class="duration-debug">{{DURATION_MS}}ms</div>
</div>

<script>
  // 若 hook_big_text 不含数字/货币/% 等，视作纯文字，缩字号
  (function(){
    var el = document.getElementById('hookBig');
    if (!el) return;
    var t = (el.textContent || '').trim();
    if (!/[0-9¥$%×倍万亿]/.test(t)) {
      el.classList.add('is-text');
    }
  })();
</script>
</body>
</html>
